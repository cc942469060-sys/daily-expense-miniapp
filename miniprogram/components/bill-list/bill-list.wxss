.bill-group { margin-top: 24rpx; }
.group-heading { padding: 12rpx 4rpx 18rpx; font-size: 25rpx; color: #596E60; }
.bill-card { background: #FFF; border: 1rpx solid #E9EEE8; border-radius: 26rpx; padding: 0 24rpx; }
.bill-row { padding: 26rpx 0; border-bottom: 1rpx solid #EFF2ED; }
.bill-row:last-child { border-bottom: 0; }
.bill-main { flex: 1; min-width: 0; }
.bill-icon { width: 76rpx; height: 76rpx; border-radius: 22rpx; background: #F4F6F0; display: flex; justify-content: center; align-items: center; font-size: 38rpx; flex-shrink: 0; }
.bill-description { flex: 1; min-width: 0; }
.bill-name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-weight: 550; }
.bill-meta { font-size: 21rpx; margin-top: 8rpx; }
.bill-value { text-align: right; font-weight: 650; font-size: 29rpx; }
.refund { color: #738C77; font-size: 20rpx; margin-top: 8rpx; font-weight: 400; }
.bill-hover { opacity: .65; }
.group-heading { flex-wrap: wrap; gap: 8rpx; }
.group-heading .muted { overflow-wrap: anywhere; }
.bill-value { max-width: 48%; overflow-wrap: anywhere; }

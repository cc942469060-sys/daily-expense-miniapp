page { background: #F6F7F2; color: #24392E; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 28rpx; }
view, input, textarea, button { box-sizing: border-box; }
button { margin: 0; font-size: 28rpx; font-weight: 600; border-radius: 22rpx; }
button::after { border: 0; }
button[disabled] { opacity: .48; }
.page { padding: 32rpx 30rpx calc(40rpx + env(safe-area-inset-bottom)); }
.row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.start { justify-content: flex-start; }
.title { font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.subtitle { color: #7B897F; font-size: 24rpx; margin-top: 12rpx; line-height: 1.7; }
.panel { background: #FFF; border: 1rpx solid #E9EEE8; border-radius: 30rpx; padding: 30rpx; margin-top: 26rpx; }
.section-title { font-size: 30rpx; font-weight: 650; }
.muted { color: #7B897F; font-size: 24rpx; }
.link { color: #22684C; font-size: 26rpx; padding: 14rpx 0; }
.hero { background: #245C46; color: #FFF; border: 0; }
.hero .muted { color: #C5D8CC; }
.eyebrow { letter-spacing: 3rpx; font-size: 22rpx; }
.amount { font-size: 68rpx; font-weight: 700; margin: 18rpx 0; line-height: 1.2; overflow-wrap: anywhere; }
.currency { font-size: 32rpx; margin-right: 10rpx; font-weight: 400; }
.metric { font-size: 32rpx; font-weight: 650; margin-top: 10rpx; }
.metrics { display: flex; gap: 34rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.18); }
.metrics > view { flex: 1; min-width: 0; }
.primary { color: #FFF; background: #22684C; padding: 6rpx 20rpx; }
.secondary { color: #22684C; background: #EAF2EB; padding: 6rpx 20rpx; }
.danger { color: #B04E49; background: #FBEFEC; }
.small-button { font-size: 24rpx; line-height: 2.2; padding: 6rpx 24rpx; border-radius: 16rpx; }
.add-button { margin-top: 26rpx; line-height: 2.6; font-size: 32rpx; }
.empty { text-align: center; padding: 60rpx 24rpx; color: #7B897F; line-height: 1.9; }
.empty-icon { font-size: 64rpx; margin-bottom: 14rpx; }
.chip { padding: 15rpx 22rpx; border-radius: 18rpx; background: #F0F3EF; font-size: 24rpx; color: #64756A; }
.chip.active { color: #22684C; background: #E2EEE3; font-weight: 650; }
.field { padding: 24rpx 0; border-bottom: 1rpx solid #EFF2ED; }
.field:last-child { border-bottom: 0; }
.field-label { color: #62776A; font-size: 26rpx; margin-bottom: 16rpx; }
.input { background: #F5F7F2; border-radius: 16rpx; padding: 22rpx; min-height: 84rpx; width: 100%; font-size: 28rpx; }
.note { font-size: 23rpx; color: #7B897F; line-height: 1.8; margin-top: 18rpx; }
.progress { height: 12rpx; background: #EAF0E9; border-radius: 10rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #6EAF81; border-radius: 10rpx; }
.menu-item { padding: 26rpx 0; border-bottom: 1rpx solid #EFF2ED; }
.menu-item:last-child { border-bottom: 0; }
.arrow { color: #97A49B; font-size: 36rpx; }
.error { background: #FCEEE7; color: #934A33; padding: 24rpx; border-radius: 20rpx; line-height: 1.8; margin-top: 24rpx; }
.spacer { height: 24rpx; }

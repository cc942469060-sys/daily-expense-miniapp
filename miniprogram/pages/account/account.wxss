.account-action { width: 100%; min-height: 112rpx; margin-top: 24rpx; padding: 24rpx; font-size: 32rpx; line-height: 1.5; display: flex; align-items: center; justify-content: center; }
.account-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }.account-note { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.8; }
.hero-note { color: #E5E9C8; font-size: 24rpx; margin-top: 16rpx; }.amount-input { font-size: 40rpx; height: 100rpx; }.note-input { min-height: 160rpx; }
.history-item { padding: 26rpx 0; border-bottom: 1rpx solid #EFF2ED; }.history-item:last-child { border-bottom: 0; }.history-amount { max-width: 65%; text-align: right; overflow-wrap: anywhere; font-weight: 600; }

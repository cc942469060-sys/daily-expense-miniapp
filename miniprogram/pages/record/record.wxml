<view class="page" wx:if="{{ready}}">
  <view class="subtitle">{{id ? '每一笔，都有迹可循' : '记下一笔小小的日常'}}</view>
  <view class="amount-panel"><view class="field-label">消费金额（元）</view><view class="row start"><text class="amount-symbol">¥</text><input class="amount-input" type="digit" value="{{amount}}" placeholder="0.00" maxlength="10" focus="{{!id}}" data-field="amount" bindinput="input" /></view></view>
  <view class="panel"><view class="field-label">选择分类</view><view class="category-grid"><view wx:for="{{categories}}" wx:key="id" class="category {{categoryId === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="category"><view class="category-icon">{{item.icon}}</view><view class="category-name">{{item.name}}</view></view></view></view>
  <view class="panel">
    <view class="field row"><text>消费日期</text><picker mode="date" value="{{date}}" start="2000-01-01" end="{{today}}" bindchange="dateChange"><view class="link">{{date}} ›</view></picker></view>
    <view class="field row"><text>时间</text><picker mode="time" value="{{time}}" bindchange="timeChange"><view class="link">{{time}} ›</view></picker></view>
    <view class="field row"><text>支付方式</text><picker range="{{payments}}" value="{{paymentIndex}}" bindchange="paymentChange"><view class="link">{{payments[paymentIndex]}} ›</view></picker></view>
    <view class="field"><view class="field-label">备注 · 可选</view><input class="input" value="{{note}}" placeholder="例如：午饭、买耳机" maxlength="100" data-field="note" bindinput="input" /></view>
    <view wx:if="{{id}}" class="field"><view class="field-label">累计退款金额（元）</view><input class="input" type="digit" value="{{refund}}" maxlength="10" data-field="refund" bindinput="input" /><view class="note">填写这笔消费的累计退款额，统计会从原消费日期扣减。无退款填 0。</view></view>
  </view>
  <view class="save-area"><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">{{id ? '保存修改' : '保存这笔消费'}}</button><button wx:if="{{!id}}" class="secondary extra-button" bindtap="saveMore" disabled="{{saving}}">保存并再记一笔</button><button wx:else class="danger extra-button" bindtap="remove" disabled="{{saving}}">删除账单</button></view>
</view>

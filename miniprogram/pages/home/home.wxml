<view class="page">
  <view class="row"><view><view class="title">把日子，记清楚。</view><view class="subtitle">小日账 · {{today}}</view></view><text class="plant">🌿</text></view>
  <view wx:if="{{storageError}}" class="error" bindtap="backup">{{storageError}}<view class="link">前往恢复备份 ›</view></view>
  <block wx:else>
    <view class="panel hero">
      <view class="eyebrow muted">本月结余</view><view class="amount" bindtap="monthBills"><text class="currency">¥</text>{{monthSummary.balanceText}}</view>
      <view class="metrics">
        <view data-type="income" bindtap="monthBills"><view class="muted">本月收入 ›</view><view class="metric">¥{{monthSummary.incomeText}}</view></view>
        <view data-type="expense" bindtap="monthBills"><view class="muted">本月支出 ›</view><view class="metric">¥{{monthSummary.expenseText}}</view></view>
      </view>
    </view>
    <view class="panel today-panel">
      <view class="row"><text class="section-title">今日收支</text><text class="muted">今天记了 {{count}} 笔</text></view>
      <view class="overview-metrics">
        <view data-type="income" bindtap="todayBills"><view class="muted">收入 ›</view><view class="metric income-text">¥{{todaySummary.incomeText}}</view></view>
        <view data-type="expense" bindtap="todayBills"><view class="muted">支出 ›</view><view class="metric">¥{{todaySummary.expenseText}}</view></view>
      </view>
    </view>
    <button class="primary add-button" bindtap="add">＋ 记一笔</button>
    <view wx:if="{{budget}}" class="panel"><view class="row"><text class="section-title">本月支出预算</text><text class="muted">{{overspent ? '已超出' : '还可花'}} ¥{{remainingText}}</text></view><view class="progress budget-progress"><view class="progress-fill" style="width: {{budgetPercent}}%;"></view></view><view class="note">按净支出计算，收入不抵扣预算用量。</view></view>
    <view class="note">结余 = 收入 − 净支出。退款扣减原支出日期，结余不代表账户余额。</view>
    <view class="row recent-heading"><text class="section-title">最近记录</text><text class="link" bindtap="allBills">全部账单 ›</text></view>
    <bill-list groups="{{groups}}" bind:select="select" />
    <view class="note" wx:if="{{groups.length}}">显示最近 8 笔，日期小计包含当天全部记录。点击记录可编辑，支出详情可登记退款。</view>
  </block>
</view>

<view class="page">
  <view class="title">资产与负债分类</view><view class="subtitle">独立管理账户分类，归档账户也会一起迁移</view>
  <view wx:if="{{storageError}}" class="error">{{storageError}}</view>
  <block wx:else>
    <view class="type-tabs"><view class="type-tab {{kind === 'asset' ? 'selected' : ''}}" data-kind="asset" bindtap="kindChange">资产分类</view><view class="type-tab {{kind === 'liability' ? 'selected' : ''}}" data-kind="liability" bindtap="kindChange">负债分类</view></view>
    <view class="panel"><view class="row"><text class="section-title">{{editingId ? '编辑分类' : '新增分类'}}</text><button wx:if="{{editingId}}" class="secondary small-button" bindtap="cancel">取消编辑</button></view><input class="input name-input" value="{{name}}" maxlength="8" placeholder="分类名称，最多 8 个字" bindinput="input" /><view class="icon-grid"><view wx:for="{{icons}}" wx:key="*this" class="icon-choice {{icon === item ? 'selected' : ''}}" data-icon="{{item}}" bindtap="pickIcon">{{item}}</view></view><button class="primary category-action" bindtap="save">{{editingId ? '保存修改' : '添加分类'}}</button></view>
    <view wx:if="{{deletingId}}" id="migration" class="panel"><view class="section-title">迁移账户</view><view class="note">选择相同类型下的新分类，历史金额不受影响。</view><picker range="{{targets}}" range-key="name" value="{{targetIndex}}" bindchange="targetChange"><view class="input migration-picker">{{targets[targetIndex].icon}} {{targets[targetIndex].name}} ▾</view></picker><view class="row"><button class="secondary small-button" bindtap="cancelRemove">取消</button><button class="danger small-button" bindtap="remove">迁移并删除</button></view></view>
    <view class="panel"><view class="section-title">{{kind === 'liability' ? '负债' : '资产'}}分类 · {{categories.length}} / 40</view><view wx:for="{{categories}}" wx:key="id" class="row menu-item"><view class="category-info" bindtap="edit" data-id="{{item.id}}"><view>{{item.icon}} {{item.name}}</view><view class="subtitle">{{item.count}} 个账户 · 点击编辑</view></view><button class="danger small-button" data-id="{{item.id}}" bindtap="beginRemove">删除</button></view></view>
  </block>
</view>

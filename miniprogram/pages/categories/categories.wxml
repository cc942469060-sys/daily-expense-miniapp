<view class="page">
  <view class="title">你的消费分类</view><view class="subtitle">让每一笔，都有合适的位置</view>
  <view class="panel"><view class="row"><text class="section-title">{{editingId ? '编辑分类' : '新增分类'}}</text><text wx:if="{{editingId}}" class="link" bindtap="cancel">取消编辑</text></view><input class="input name-input" value="{{name}}" maxlength="8" placeholder="分类名称，最多 8 个字" bindinput="input" /><view class="icon-grid"><view wx:for="{{icons}}" wx:key="*this" class="icon-choice {{icon === item ? 'selected' : ''}}" data-icon="{{item}}" bindtap="pickIcon">{{item}}</view></view><button class="primary" bindtap="save">{{editingId ? '保存修改' : '添加分类'}}</button></view>
  <view wx:if="{{deletingId}}" id="migration" class="panel"><view class="section-title">迁移历史账单</view><view class="note">删除分类前，为此分类下的账单选择一个新分类。</view><picker range="{{targets}}" range-key="name" value="{{targetIndex}}" bindchange="targetChange"><view class="input migration-picker">{{targets[targetIndex].icon}} {{targets[targetIndex].name}} ▾</view></picker><view class="row"><button class="secondary small-button" bindtap="cancelRemove">取消</button><button class="danger small-button" bindtap="remove">迁移并删除</button></view></view>
  <view class="panel"><view class="section-title">已有分类 · {{categories.length}} / 40</view><view wx:for="{{categories}}" wx:key="id" class="row menu-item"><view class="category-info" bindtap="edit" data-id="{{item.id}}"><view>{{item.icon}} {{item.name}}</view><view class="subtitle">{{item.count}} 笔记录 · 点击编辑</view></view><button class="danger small-button" data-id="{{item.id}}" bindtap="beginRemove">删除</button></view></view>
</view>
